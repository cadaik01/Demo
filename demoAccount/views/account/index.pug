doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Account List
    body 
        h4 
            a(href='/account/create') Create New Account
        h1 Account List 
        table 
            thead 
                tr 
                    th Email
                    th Phone
                    th Fullname
            tbody
                if accounts.length > 0 
                    each item in accounts
                        tr 
                            td= item.email
                            td= item.phone
                            td= item.fullname
                        //-     td
                        //-         img(src=`/images/${item.image}`, alt=`${item.fullname}`, style='width: 100px; height: auto')
                        //- td
                        //-     a(href=`/Accounts/edit/${item._id}`) Edit 
                        //- td
                        //-     a(href=`/Account/delete/${item._id}`) Delete
                else 
                    tr 
                        td(colspan=3) No Accounts 
